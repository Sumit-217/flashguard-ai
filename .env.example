# FlashGuard AI - Environment Configuration Template
# Copy this file to '.env' for local development.
# DO NOT store production secrets or credentials in this file.
# Note: The actual '.env' file is ignored by Git (.gitignore).

# ==============================================================================
# 1. ACTIVE / IMPLEMENTED CONFIGURATION (FastAPI Backend & AI Pipeline)
# ==============================================================================

# CORS: Comma-separated list of allowed origins for dashboard/web clients.
# Native mobile apps (e.g. Flutter) bypass browser CORS checks.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# National Water Data Portal (NWDP / NWIC) CKAN Datastore
NWDP_BASE_URL=https://nwdp.nwic.gov.in
NWDP_RESOURCE_ID=8b406187-0fee-40b9-8cd9-a249e0ce1903
NWDP_PAGE_SIZE=100
NWDP_TIMEOUT_SECONDS=30.0

# In-memory Telemetry Cache TTL (seconds)
CACHE_TTL_SECONDS=300

# Prototype Rainfall Risk Thresholds (mm) - Hourly Accumulation
RAINFALL_MODERATE_MM=25.0
RAINFALL_HIGH_MM=50.0
RAINFALL_CRITICAL_MM=80.0

# Prototype Rolling Accumulation Thresholds (mm)
RAINFALL_6H_ELEVATED_MM=50.0
RAINFALL_6H_SEVERE_MM=100.0
RAINFALL_24H_ELEVATED_MM=75.0
RAINFALL_24H_SEVERE_MM=150.0

# ==============================================================================
# 2. PLANNED / FUTURE SCOPE (Not active in current prototype)
# ==============================================================================

# Spatial Database (PostgreSQL + PostGIS)
# DATABASE_URL=postgresql://user:password@localhost:5432/flashguard_dev

# Authentication & Access Control
# JWT_SECRET=placeholder_jwt_secret_for_future_auth

# Emergency Messaging & Push Notifications
# FCM_PROJECT_ID=placeholder_fcm_project_id
# SMS_API_URL=https://api.example-sms-gateway.com/send
# SMS_API_KEY=placeholder_sms_gateway_api_key

# IoT Telemetry & Routing
# MQTT_BROKER_URL=mqtt://localhost:1883
# OSRM_URL=http://localhost:5000
