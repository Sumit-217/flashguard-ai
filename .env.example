# FlashGuard AI - Example Environment Configuration
# DO NOT place actual passwords or API keys in this file.
# Copy this file to '.env' and fill in your local development values.
# The '.env' file is ignored by Git to prevent committing secrets.

# Backend & Database
DATABASE_URL=postgresql://user:password@localhost:5432/flashguard_dev
JWT_SECRET=your_super_secret_jwt_key_here

# Firebase Cloud Messaging
FCM_PROJECT_ID=your_fcm_project_id_placeholder

# SMS Gateway (Abstract Interface)
SMS_API_URL=https://api.example-sms-gateway.com/send
SMS_API_KEY=your_sms_gateway_api_key_placeholder

# IoT & Telemetry
MQTT_BROKER_URL=mqtt://localhost:1883

# Routing
OSRM_URL=http://localhost:5000
